{
  "version": 2,
  "builds": [
    {
        "src": "package.json",
        "use": "@vercel/static-build",
        "config": {
        "installCommand": "npm install --include=dev",
        "buildCommand": "npm run build"
        }
    }
    ],
  "routes": [
    { "src": "/(.*)", "dest": "/" }
  ]
}
